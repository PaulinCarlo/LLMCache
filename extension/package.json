{
  "name": "promptcache-extension",
  "displayName": "PromptCache",
  "version": "0.1.0",
  "description": "Semantic caching layer for LLM prompts in your browser",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/messaging": "0.6.2",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@plasmohq/tsup-config": "0.2.4",
    "plasmo": "0.88.3",
    "typescript": "5.1.3",
    "@types/node": "20.4.1",
    "@types/react": "18.2.14",
    "@types/react-dom": "18.2.6"
  },
  "manifest": {
    "host_permissions": ["http://localhost:5000/*", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
    "permissions": ["storage", "activeTab"]
  }
}
