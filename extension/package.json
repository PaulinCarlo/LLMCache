{
  "name": "promptcache-extension",
  "displayName": "PromptCache",
  "version": "0.1.0",
  "description": "Semantic caching layer for LLM prompts in your browser",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/messaging": "0.7.2",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "@types/node": "20.4.1",
    "@types/react": "18.2.14",
    "@types/react-dom": "18.2.6",
    "plasmo": "0.90.5",
    "typescript": "5.1.3"
  },
  "manifest": {
    "host_permissions": [
      "http://localhost:5001/*",
      "https://chat.openai.com/*",
      "https://chatgpt.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*",
      "https://github.com/*"
    ],
    "permissions": [
      "storage",
      "activeTab",
      "tabs"
    ],
    "externally_connectable": {
      "matches": [
        "http://localhost:3001/*",
        "http://127.0.0.1:3001/*"
      ]
    }
  }
}
